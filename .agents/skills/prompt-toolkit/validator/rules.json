{
  "max_length": 8000,
  "max_tokens_estimate": 6000,
  "forbidden_patterns": [
    "ignore previous instructions",
    "disregard all prior",
    "DAN mode",
    "jailbreak"
  ],
  "dangerous_instructions": [
    "rm -rf",
    "sudo",
    "curl.*\\|.*sh",
    "eval\\("
  ],
  "coherence": {
    "min_words": 3,
    "max_repetition_ratio": 0.4,
    "require_context": true
  },
  "severity_levels": {
    "block": ["forbidden_patterns", "dangerous_instructions"],
    "warn": ["max_length", "coherence"]
  }
}